{
  "name": "software-factory-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4202",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "analyze": "cross-env ANALYZE=true next build",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run test:run"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.49.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "nextjs-toploader": "^3.9.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
